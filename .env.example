# 复制为 .env 后按需修改；进程环境变量优先级高于本文件。
# 钉钉自定义机器人（加签模式）
XIAOCAN_DINGTALK_WEBHOOK=
XIAOCAN_DINGTALK_SECRET=
XIAOCAN_DINGTALK_TITLE=小蚕余量监控

# 请求节流：任意两次接口请求最小间隔（秒）
XIAOCAN_MIN_REQUEST_INTERVAL=3
XIAOCAN_REQUEST_TIMEOUT=8
XIAOCAN_RETRIES=1

# 可选：SOCKS5 代理（网关 RPC 与钉钉推送都会走它）
# 支持 socks5:// 与 socks5h://（socks5h 由代理远端解析域名），可带用户名/密码。
# 留空表示直连。示例：
#   XIAOCAN_SOCKS5_PROXY=socks5h://127.0.0.1:1080
#   XIAOCAN_SOCKS5_PROXY=socks5://user:pass@127.0.0.1:1080
XIAOCAN_SOCKS5_PROXY=

# 默认定位（search/add 的默认值）
XIAOCAN_DEFAULT_LAT=39.904200
XIAOCAN_DEFAULT_LON=116.407400
XIAOCAN_DEFAULT_CITY=110100

# 可选：覆盖配置/状态文件路径
# XIAOCAN_CONFIG_PATH=
# XIAOCAN_STATE_PATH=
# XIAOCAN_ENV_FILE=
